<li>
	{{# if this.url }}
	<a href="{{{ this.url }}}" class="{{{ this.class }}}">
		{{# if this.current }}&gt;{{/ if }}{{ langFallback this 'name' }}{{# if this.active }}*{{/if}}
	</a>
	{{ else }}
	<span class="{{{ this.class }}}">{{{ this.name }}}{{# if this.active }}*{{/ if }}</span>
	{{/ if }}
	{{# eachNavFromFolder this true 2 }}
		{{> partials/navigation/contentnavelements }}
	{{/ eachNavFromFolder }}
</li>
